# Environment configuration for the H1.R0 Vapor app.

# PostgreSQL connection (preferred: a single URL).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/h1r0_development
# Or set the individual parts (used only when DATABASE_URL is unset):
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=h1r0_development

# Redis connection for the background job queue.
REDIS_URL=redis://localhost:6379

# Run Fluent migrations automatically on boot (use only on fresh databases;
# the existing live schema is already migrated).
AUTO_MIGRATE=false

# Run queued jobs inside the web process instead of a separate `queues` worker.
# Handy in development; in production run a dedicated worker:
#   ./App queues
IN_PROCESS_JOBS=false

# Vapor log level: trace, debug, info, notice, warning, error, critical.
LOG_LEVEL=info
