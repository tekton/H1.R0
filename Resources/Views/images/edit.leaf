#extend("base"):
#export("content"):
<h1>Editing image</h1>

<form action="/images/#(image.id)" method="post">
    <div class="field">
        <label>Location</label><br>
        <input type="text" name="location" value="#(image.location)">
    </div>
    <div class="field">
        <label>Name</label><br>
        <input type="text" name="name" value="#(image.name)">
    </div>
    <div class="actions">
        <input type="submit" value="Update Image">
    </div>
</form>

<a href="/images/#(image.id)">Show</a> |
<a href="/images">Back</a>

<form action="/images/#(image.id)/delete" method="post" onsubmit="return confirm('Are you sure?');">
    <input type="submit" value="Destroy">
</form>
#endexport
#endextend
