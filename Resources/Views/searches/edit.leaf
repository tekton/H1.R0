#extend("base"):
#export("content"):
<h1>Editing search</h1>

<form action="/searches/#(search.id)" method="post">
    <div class="field">
        <label>Hash</label><br>
        <input type="text" name="md5hash" value="#(search.md5hash)">
    </div>
    <div class="field">
        <label>Serial</label><br>
        <input type="text" name="serial" value="#(search.serial)">
    </div>
    <div class="actions">
        <input type="submit" value="Update Search">
    </div>
</form>

<a href="/searches/#(search.id)">Show</a> |
<a href="/searches">Back</a>
#endexport
#endextend
